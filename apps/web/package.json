{
  "name": "neuge-voice",
  "version": "0.8.2",
  "private": true,
  "author": "Soumyajit Basu <soumyajit.basu22@gmail.com>",
  "homepage": "https://github.com/neuge-ai/neuge-voice",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b --noEmit",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron . --no-sandbox\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.neugeai.voice",
    "productName": "Neuge Voice",
    "mac": {
      "target": ["dmg", "zip"],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Neuge Voice needs microphone access to listen to your voice commands."
      }
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "../electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../../dist/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.1",
    "typescript": "^5.6.0",
    "vite": "5.4.11"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^30.5.1",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "wait-on": "^9.0.10"
  }
}
